QDialog {
    background-color: qlineargradient(
        spread: pad, x1: 1, y1: 1, x2: 0, y2: 0,
        stop: 0 rgba(81, 0, 135, 255),
        stop: 0.427447 rgba(41, 61, 132, 235),
        stop: 1 rgba(155, 79, 165, 255)
    );
    color: white;
    font-family: Consolas;
    font-size: 11pt;
}

QLabel {
    color: #d0cbe1;
    font-weight: bold;
}

QLineEdit {
    background-color: rgba(60, 40, 90, 200);
    color: white;
    border: 1px solid rgba(180, 180, 255, 60);
    border-radius: 5px;
    padding: 5px;
}

QListView {
    background-color: rgba(50, 30, 80, 200);
    color: white;
    border: 1px solid rgba(180, 180, 255, 60);
    border-radius: 6px;
    padding: 4px;
}

QListView::item {
    padding: 6px;
}

QListView::item:selected {
    background-color: rgba(255, 255, 255, 50);
    color: white;
}

QPushButton {
    background-color: rgba(100, 60, 150, 220);
    color: white;
    border: 1px solid rgba(255, 255, 255, 40);
    border-radius: 6px;
    padding: 6px 12px;
}

QPushButton:hover {
    background-color: rgba(120, 80, 180, 240);
}

QPushButton:pressed {
    background-color: rgba(90, 40, 120, 255);
}

QTextEdit {
    background-color: rgba(60, 40, 90, 200);
    color: white;
    border: 1px solid rgba(180, 180, 255, 60);
    border-radius: 6px;
    padding: 6px;
}

QComboBox {
    background-color: rgba(255, 255, 255, 30);
    border: 1px solid rgba(255, 255, 255, 70);
    border-radius: 5px;
    padding: 5px 28px 5px 8px;
    font-family: Consolas;
    font-size: 12pt;
    color: white;
}

QComboBox QAbstractItemView {
    background-color: rgba(41, 61, 132, 235);
    selection-background-color: rgba(155, 79, 165, 200);
    color: white;
    font-family: Consolas;
    border: 1px solid rgba(255, 255, 255, 40);
}
