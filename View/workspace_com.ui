   <string notr="true">QWidget{
background-color: qlineargradient(spread:pad, x1:1, y1:1, x2:0, y2:0, stop:0 rgba(81, 0, 135, 255), stop:0.427447 rgba(41, 61, 132, 235), stop:1 rgba(155, 79, 165, 255));
font-family: Consolas;
}
QPushButton {
    background-color: rgba(155, 79, 165, 180);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 5px;
    padding: 8px 16px;
    color: white;
    font-weight: bold;
}
QPushButton:hover {
    background-color: rgba(155, 79, 165, 220);
}

QPushButton:pressed {
    background-color: rgba(81, 0, 135, 200);
}

QPushButton:disabled {
    background-color: rgba(155, 79, 165, 80);
    color: rgba(255, 255, 255, 0.5);
}
QStackedWidget {
	background: transparent;
	border: none;
}
QLineEdit {
    background-color: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 5px;
    padding: 8px;
    color: white;
    font-size: 13px;
    selection-background-color: rgba(155, 79, 165, 150);
}

QLineEdit:focus {
    border: 1px solid rgba(155, 79, 165, 200);
    background-color: rgba(255, 255, 255, 0.15);
}

QLineEdit::placeholder {
    color: rgba(255, 255, 255, 0.5);
}
QTableView {
    background-color: rgba(255, 255, 255, 30);
    border: 1px solid rgba(255, 255, 255, 40);
    border-bottom-right-radius: 7px;
    border-bottom-left-radius: 7px;
}
QTableView::item {
    border: none;
    border-bottom: 1px solid rgba(255, 255, 255, 50);
    padding: 5px;
    color: white; /* чтобы проверить, точно ли стиль применяется */
}
QTableView::item:selected {
    border: none;
    color: white;
    background-color: rgba(255, 255, 255, 80);
}
QHeaderView::section {
    background-color: rgb(53, 53, 53);
    color: white;
    border: none;
    font-size: 10pt;
}
QTableView QLineEdit {
        background-color: #333333;
        color: white;
    }</string>
