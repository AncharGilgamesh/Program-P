QDialog {
    background-color: rgba(30, 10, 60, 220); /* слегка затемнённый полупрозрачный фон */
    color: white;
    font-family: Consolas;
    font-size: 11pt;
    border-radius: 12px;
    padding: 10px;
}

QLabel {
    color: #d0cbe1;
    font-weight: bold;
}

QLineEdit {
    background-color: rgba(60, 40, 90, 200);
    color: white;
    border: 1px solid rgba(180, 180, 255, 60);
    border-radius: 5px;
    padding: 5px;
}

QListView {
    background-color: rgba(50, 30, 80, 200);
    border: 1px solid rgba(180, 180, 255, 60);
    border-radius: 6px;
    padding: 4px;
}

QListView::item {
    padding: 6px;
}

QListView::item:selected {
    background-color: rgba(255, 255, 255, 50);
    color: white;
}

QPushButton {
    background-color: rgba(100, 60, 150, 220);
    color: white;
    border: 1px solid rgba(255, 255, 255, 40);
    border-radius: 6px;
    padding: 6px 12px;
}

QPushButton:hover {
    background-color: rgba(120, 80, 180, 240);
}

QPushButton:pressed {
    background-color: rgba(90, 40, 120, 255);
}

QTextEdit {
    background-color: rgba(60, 40, 90, 200);
    color: white;
    border: 1px solid rgba(180, 180, 255, 60);
    border-radius: 6px;
    padding: 6px;
}
