  <property name="styleSheet">
   <string notr="true">QWidget{
background-color: qlineargradient(spread:pad, x1:1, y1:1, x2:0, y2:0, stop:0 rgba(81, 0, 135, 255), stop:0.427447 rgba(41, 61, 132, 235), stop:1 rgba(155, 79, 165, 255));
font-family: Consolas;
}
QPushButton {
    background-color: rgba(155, 79, 165, 180);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 5px;
    padding: 8px 16px;
    color: white;
    font-weight: bold;
}
QPushButton:hover {
    background-color: rgba(155, 79, 165, 220);
}

QPushButton:pressed {
    background-color: rgba(81, 0, 135, 200);
}

QPushButton:disabled {
    background-color: rgba(155, 79, 165, 80);
    color: rgba(255, 255, 255, 0.5);
}
QStackedWidget {
	background: transparent;
	border: none;
}
QLineEdit {
    background-color: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 5px;
    padding: 8px;
    color: white;
    font-size: 13px;
    selection-background-color: rgba(155, 79, 165, 150);
}

QLineEdit:focus {
    border: 1px solid rgba(155, 79, 165, 200);
    background-color: rgba(255, 255, 255, 0.15);
}

QLineEdit::placeholder {
    color: rgba(255, 255, 255, 0.5);
}</string>
